      "name": "01 - Autentikasi dan Mahasiswa",
      "item": [
        {
          "name": "Login mahasiswa 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Device-ID",
                "value": "{{mhs1Device}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"mhs1\",\"password\":\"mhs123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login berhasil\", () => pm.response.to.have.status(200));",
                  "const d=pm.response.json();",
                  "pm.environment.set(\"mhs1AccessToken\", d.accessToken);",
                  "pm.environment.set(\"mhs1RefreshToken\", d.refreshToken);"
