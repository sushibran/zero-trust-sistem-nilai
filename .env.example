NODE_ENV=development
DB_PATH=./data/zero-trust.db
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_SERVICE_SECRET=replace-with-a-different-long-random-secret
GATEWAY_SECRET=replace-with-a-long-random-gateway-secret
SERVICE_CLIENT_ID=nilai-service
SERVICE_CLIENT_SECRET=replace-with-a-long-random-client-secret
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL_DAYS=1
SERVICE_TOKEN_TTL=5m
ACCESS_START=07:00
ACCESS_END=21:00
TIMEZONE=Asia/Jakarta
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002
GATEWAY_URL=http://localhost:3000
NILAI_SERVICE_URL=http://localhost:3001
TRANSKRIP_SERVICE_URL=http://localhost:3002
